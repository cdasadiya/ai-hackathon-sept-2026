# Copy to .env for local development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Local PostgreSQL 18.x (peer auth on Linux) or Render DATABASE_URL in production
DATABASE_URL=postgresql:///hospital_blood_report

# Production on Render (these HTTPS settings default on when DEBUG=False)
# DEBUG=False
# REQUIRE_POSTGRES=True
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# HEALTHZ_RUN_MIGRATIONS=false
# SEED_DEMO_USERS=false
#
# Plain HTTP (Docker Compose / CI) must opt out:
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
