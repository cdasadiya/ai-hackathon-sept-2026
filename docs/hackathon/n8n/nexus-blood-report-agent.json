{
  "name": "Nexus Health — Blood Report Agent (BFG)",
  "nodes": [
    {
      "parameters": {
        "content": "## Nexus Health × Django\n\n1. Configure **Header Auth** on Webhook (Authorization: Bearer = Django `n8n_webhook_secret`).\n2. Attach **Google Gemini(PaLM) API** credential to **Gemini Analyze (HTTP)** (Query Auth: param `key`).\n3. Replace **REPLACE_CALLBACK_TOKEN** in Django Callback headers.\n4. Activate → copy **Production** webhook URL into Django Admin → Integration Configuration.",
        "height": 220,
        "width": 520,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-400, 120],
      "id": "7786c60a-d8b7-4fbe-8fa1-cb33d1c0c14a",
      "name": "Setup Notes"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nexus-blood-report",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "id": "2c4e3426-88d4-4fa8-892c-22662fe42da8",
      "name": "Webhook Nexus Blood Report",
      "webhookId": "nexus-blood-report-bfg",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_ME",
          "name": "Django → n8n Webhook Bearer"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"accepted\", \"blood_report_id\": ($json.body?.blood_report_id ?? $json.blood_report_id) } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [240, 300],
      "id": "250c38ec-62cc-4c74-900a-6f34e55e0b60",
      "name": "Respond Accepted"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "blood_report_id",
              "value": "={{ $json.body?.blood_report_id ?? $json.blood_report_id }}",
              "type": "number"
            },
            {
              "id": "a2",
              "name": "patient_id",
              "value": "={{ $json.body?.patient_id ?? $json.patient_id }}",
              "type": "number"
            },
